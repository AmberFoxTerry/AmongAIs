* {
    box-sizing: border-box;
}

html,
body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: #080a0d;
}

body {
    font-family: Arial, sans-serif;
    user-select: none;
}

#map {
    position: fixed;
    inset: 0;

    width: 100vw;
    height: 100vh;

    display: block;

    background: #080a0d;
}
